alias c="clear"
alias n="nvim"
alias oc="opencode"

weather() {
    if [ -z "$1" ]; then
        echo "Usage: w <location>"
        return 1
    fi
    curl "wttr.in/$1"
}

ip() {
  case "$1" in
    public)
      echo "$(curl -s https://api.ipify.org | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}')"
      ;;
    internal)
      ipconfig getifaddr $(route get default 2>/dev/null | awk '/interface: / {print $2}')
      ;;
    private)
      ifconfig | awk '/^(utun|ppp)/ {iface=$1} iface && $1 == "inet" && $2 ~ /^10\./ {print $2; exit}'
      ;;
    *)
      echo "Usage: ip [public|internal|private]"
      return 1
      ;;
  esac
}

vconvert() {
    [[ -z "$1" ]] && { echo "Usage: vconvert <input_file> [output_file]"; return 1; }

    local input="$1" output="${2:-${1%.*}.mp4}"

    [[ -f "$input" ]] && ffmpeg -i "$input" -vf "scale='min(1280,iw)':'min(720,ih)':force_original_aspect_ratio=decrease,setpts=PTS/1.5,fps=30" -an "$output" || { echo "Error: File '$input' not found"; return 1; }
}
